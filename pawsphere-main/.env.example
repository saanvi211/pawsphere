# PawSphere Environment Variables
# Fill these in after creating your free Supabase project at https://supabase.com
# Get Gemini API key at https://aistudio.google.com/app/apikey
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_GEMINI_API_KEY=your-gemini-key-here

# Google Maps & Places API
# 1. Go to https://console.cloud.google.com/
# 2. Enable "Maps JavaScript API" and "Places API"
# 3. Create an API Key in Credentials (optional: restrict to HTTP referrers in production)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

